---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { SITE } from '../lib/site';
import { CATEGORIES } from '../lib/categories';
import { sortTools, countByCategory } from '../lib/tools';

const tools = await getCollection('tools');
const sorted = sortTools(tools);
const featured = sorted.filter((t) => t.data.featured).slice(0, 3);
const latest = sorted.slice(0, 6);
const counts = countByCategory(tools);
const cats = CATEGORIES.map((c) => ({ ...c, count: counts.get(c.slug) ?? 0 }));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: SITE.title,
    url: SITE.url,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    sameAs: [SITE.social.github],
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="container stack" style="--stack:0">
      <p class="eyebrow">Own your data · Run it yourself · Works offline</p>
      <h1>The <span class="grad">Local-First &amp; Self-Hosted</span> Stack Index</h1>
      <p class="lead">A curated, no-nonsense directory of software that keeps your data on your own devices and servers — not someone else's cloud.</p>

      <form class="search" action="/tools" method="get" role="search" style="margin-top:1.75rem">
        <span class="search-ico" aria-hidden="true">⌕</span>
        <input type="search" name="q" placeholder="Search {tools.length} tools — notes, photos, passwords, backups…" aria-label="Search tools" />
      </form>

      <div class="cta-row">
        <a class="btn btn-primary" href="/tools">Browse all tools →</a>
        <a class="btn btn-ghost" href="/categories">Explore categories</a>
      </div>

      <div class="stats">
        <div><b>{tools.length}</b> curated tools</div>
        <div><b>{CATEGORIES.length}</b> categories</div>
        <div><b>100%</b> local-first / self-hosted</div>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section container">
      <p class="eyebrow">Featured</p>
      <h2 style="margin-bottom:1.25rem">Start here</h2>
      <div class="grid cols-3">
        {featured.map((entry) => <ToolCard entry={entry} />)}
      </div>
    </section>
  )}

  <section class="section container">
    <p class="eyebrow">Browse</p>
    <h2 style="margin-bottom:1.25rem">Categories</h2>
    <div class="grid cols-cat">
      {cats.map((c) => (
        <a class="cat-card" href={`/categories/${c.slug}`}>
          <span class="ico" aria-hidden="true">{c.icon}</span>
          <h3>{c.name}</h3>
          <p class="muted" style="font-size:.88rem">{c.blurb}</p>
          <span class="count">{c.count} {c.count === 1 ? 'tool' : 'tools'}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section container">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap">
      <div>
        <p class="eyebrow">Fresh</p>
        <h2>Recently added</h2>
      </div>
      <a class="btn btn-ghost" href="/tools">See all →</a>
    </div>
    <div class="grid cols-3" style="margin-top:1.25rem">
      {latest.map((entry) => <ToolCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
