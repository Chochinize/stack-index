---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { SITE } from '../../lib/site';
import { CATEGORIES } from '../../lib/categories';
import { sortTools } from '../../lib/tools';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const tools = sortTools((await getCollection('tools')).filter((t) => t.data.category === category.slug));

const description = category.intro;
const canonical = `${SITE.url}/categories/${category.slug}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${category.name} · ${SITE.name}`,
    description,
    url: canonical,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: tools.length,
      itemListElement: tools.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: `${SITE.url}/tools/${t.id}`,
        name: t.data.name,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Categories', item: `${SITE.url}/categories` },
      { '@type': 'ListItem', position: 3, name: category.name, item: canonical },
    ],
  },
];
---

<BaseLayout title={`${category.name} — local-first & self-hosted`} description={description} jsonLd={jsonLd}>
  <section class="section container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span>/</span>
      <a href="/categories">Categories</a> <span>/</span>
      <span>{category.name}</span>
    </nav>

    <div style="display:flex;gap:1rem;align-items:center;margin-top:1.25rem">
      <span style="font-size:2.4rem" aria-hidden="true">{category.icon}</span>
      <h1>{category.name}</h1>
    </div>
    <p class="lead" style="margin:1rem 0 0;max-width:60ch;text-align:left">{category.intro}</p>
    <p class="result-count" style="margin-top:1rem">{tools.length} {tools.length === 1 ? 'tool' : 'tools'}</p>

    <div class="grid cols-3" style="margin-top:1.5rem">
      {tools.map((entry) => <ToolCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>
